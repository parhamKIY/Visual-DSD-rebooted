// Links pass fitted parameter summaries between models.
// Select a node and system to simulate independently. The linked inference example includes fitting data.
directive simulator deterministic
directive simulation { final=10; points=100; plots=[A; B] }
directive parameters [k=0.25]

system decay = {
  | 10 A
  | A ->{k} B
}

system reversible = {
  | 20 A
  | A <->{k}{0.1} B
}

node calibration { systems=[decay] }
node prediction { systems=[reversible] }
edge calibration -> [k=Normal] prediction
