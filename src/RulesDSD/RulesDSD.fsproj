    <Compile Include="processEquality.fs" />
    <Compile Include="resolution.fs" />
    <Compile Include="parser.fs" />
    <ProjectReference Include="../CRNEngineDotNet/CRNEngineDotNet.fsproj" />
    <ProjectReference Include="../ParserCombinators/ParserCombinators.fsproj" />
    <PackageReference Include="WebSharper.Core" Version="4.5.19.349" />
    <PackageReference Include="QuikGraph" Version="2.5.0" />
  </ItemGroup>
</Project>
